# Supabase - https://supabase.com/dashboard 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버 전용(서비스 롤) 키 - 푸시 발송 등 관리 작업에 사용. 절대 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 카카오맵 JavaScript 키 - https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
# 실종 신고 지도·지도 탭(동물병원/애견카페 검색) 기능에 필요합니다.
# 카카오 개발자 콘솔에서 '플랫폼 > Web'에 서비스 도메인을 등록하고, 'Kakao Map'과 'Local'(장소 검색) API를 활성화하세요.
NEXT_PUBLIC_KAKAO_MAP_KEY=your-kakao-javascript-key

# 웹 푸시(VAPID) - 선택. 미설정 시 알림 푸시 기능만 비활성화됩니다.
# 키 생성: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 케어 리마인더 크론 보호용 시크릿 - 선택 (api/push/care-reminders 호출 인증)
CRON_SECRET=

# ── 스캔(영수증·문서) AI 추출 ─────────────────────────────────────────────
# 어떤 provider를 기본으로 쓸지는 관리자 화면에서 라이브로 바꿀 수 있습니다
# (app_settings.ocr_provider). 아래 OCR_PROVIDER는 그 값이 없을 때의 기본값입니다.
# 각 provider는 해당 API 키가 설정돼 있어야 실제로 동작하며, 실패 시
# 다른 provider → 브라우저 무료 OCR(Tesseract.js) 순으로 자동 폴백합니다.
# 값: upstage | gemini (기본: upstage)
OCR_PROVIDER=upstage

# Upstage Information Extract API 키 - 선택(기본 provider). 영수증·문서 구조화 추출에 사용.
# https://console.upstage.ai 에서 발급.
UPSTAGE_API_KEY=
# 사용할 모델 (선택, 기본: information-extract)
UPSTAGE_MODEL=
# IE 엔드포인트 (선택). 콘솔 문서 기준으로 다르면 이 값만 교체하세요.
# 기본: https://api.upstage.ai/v1/information-extraction/chat/completions
UPSTAGE_OCR_URL=

# Google Gemini API 키 - 선택(폴백/대체 provider). 진료 영수증/사진 OCR 자동입력에 사용.
# https://aistudio.google.com/apikey 에서 무료 발급 (무료 등급 제공).
# 두 provider 키가 모두 없으면 스캔은 브라우저 무료 OCR·직접 입력으로만 동작합니다.
GEMINI_API_KEY=
# 사용할 Gemini 모델 (선택, 기본: gemini-3.6-flash)
GEMINI_MODEL=
# 스캔 폴백: 선택한 provider가 실패/한도초과면 다른 provider, 그마저 안 되면 브라우저에서
# 무료 OCR(Tesseract.js)이 자동 실행돼 날짜·금액을 채웁니다. (별도 키/설정 불필요)

# ── AI 챗봇(케어 도우미) · 멀티 provider ───────────────────────────────────
# 모델 레지스트리(src/lib/ai/models)가 env 로 구성된 OpenAI 호환 provider 들을 모아,
# 작업별 라우팅으로 챗 모델을 고릅니다. 키가 설정된 provider 만 '사용 가능'으로 잡힙니다.
# CHAT_PROVIDER 로 특정 provider 를 강제(override)할 수 있고(관리자 app_settings.chat_provider 도 동일),
# 비우면 라우팅 정책(기본: chat=upstage 우선)으로 자동 선택합니다.
# 값(예): upstage | openai | gemini | groq | together | openrouter | ollama
CHAT_PROVIDER=upstage
# 챗봇에 쓸 Upstage Solar 모델 (선택, 기본: solar-pro2). 예: solar-pro2 / solar-pro4
UPSTAGE_CHAT_MODEL=
# 챗 API base URL (선택, 기본: https://api.upstage.ai/v1 — OpenAI 호환)
UPSTAGE_CHAT_URL=
# 키는 스캔과 동일하게 UPSTAGE_API_KEY 를 재사용합니다(위에서 설정).
#
# 다른 provider(상용·오픈소스)를 쓰려면 해당 키를 설정하세요. 모두 OpenAI 호환 경로로 연결됩니다.
# 각 provider 는 <PROVIDER>_MODEL 로 모델을, <PROVIDER>_BASE_URL 로 엔드포인트를 덮을 수 있습니다.
# - OpenAI:      OPENAI_API_KEY        (기본 모델 gpt-4o-mini)
# - Gemini:      GEMINI_API_KEY        (OpenAI 호환 엔드포인트, 기본 gemini-3.6-flash / GEMINI_CHAT_MODEL)
#   ※ 오픈소스 모델 서빙(아래)으로 Llama/Qwen/Mistral 등을 같은 경로로 쓸 수 있습니다.
# - Groq:        GROQ_API_KEY          (기본 llama-3.3-70b-versatile)
# - Together:    TOGETHER_API_KEY      (기본 meta-llama/Llama-3.3-70B-Instruct-Turbo)
# - OpenRouter:  OPENROUTER_API_KEY    (기본 qwen/qwen-2.5-72b-instruct)
# - Ollama(로컬): OLLAMA_BASE_URL=http://localhost:11434/v1 (키 불필요, OLLAMA_MODEL 로 모델 지정)
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
# (선택) 모델별 토큰 단가 오버라이드(USD/100만토큰): AI_PRICE_<PROVIDER>_<MODEL>="입력,출력"
# 예: AI_PRICE_UPSTAGE_SOLAR_PRO2="0.25,0.25"  (옵저버빌리티 비용 계산에 사용)

# ── 문서 정리(Upstage Document Parse / Document Digitization) ──────────────
# 진료기록·검사지 PDF·이미지를 레이아웃 보존 구조(HTML/Markdown)로 변환. 키는 UPSTAGE_API_KEY 공용.
# 엔드포인트(선택, 기본: https://api.upstage.ai/v1/document-digitization)
UPSTAGE_PARSE_URL=
# 모델(선택, 기본: document-parse)
UPSTAGE_PARSE_MODEL=

# 앱 URL (로컬 개발)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 수익화(선택) ──────────────────────────────────────────────
# 제휴(어필리에이트): 쿠팡 파트너스 등 추천 상품 링크에 부착할 트래킹 태그.
# 미설정 시 상품 기본 링크를 그대로 사용합니다.
NEXT_PUBLIC_COUPANG_PARTNER_TAG=
# 전면 광고: 'false' 로 두면 전역 비활성화(심사/개발용). 기본은 활성.
NEXT_PUBLIC_ADS_ENABLED=
# 실제 광고망(애드센스/애드핏 등) 슬롯 ID — 연동 시 사용. 미설정 시 자체 소재로 노출.
NEXT_PUBLIC_AD_NETWORK_SLOT=
# 프리미엄 월 가격(원). 표기 + 서버 결제 금액에 사용. 미설정 시 기본 3900원.
NEXT_PUBLIC_PREMIUM_PRICE_KRW=

# 토스페이먼츠 정기결제(빌링) — 미설정 시 결제 버튼만 비활성, 나머지 기능은 정상.
# 테스트 키: https://docs.tosspayments.com → 개발자센터에서 발급(계약 불필요).
# 실서비스는 가맹 계약 후 라이브 키로 교체하면 됩니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 서버 전용(승인/청구). 절대 클라이언트에 노출 금지.
TOSS_SECRET_KEY=
# 자동 갱신 크론 보호 — /api/billing/renew (care-reminders와 동일 시크릿 공유).
# CRON_SECRET 은 위에 정의되어 있습니다.
