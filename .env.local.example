# Supabase - https://supabase.com/dashboard 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버 전용(서비스 롤) 키 - 푸시 발송 등 관리 작업에 사용. 절대 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 카카오맵 JavaScript 키 - https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
# 실종 신고 지도·지도 탭(동물병원/애견카페 검색) 기능에 필요합니다.
# 카카오 개발자 콘솔에서 '플랫폼 > Web'에 서비스 도메인을 등록하고, 'Kakao Map'과 'Local'(장소 검색) API를 활성화하세요.
NEXT_PUBLIC_KAKAO_MAP_KEY=your-kakao-javascript-key

# 웹 푸시(VAPID) - 선택. 미설정 시 알림 푸시 기능만 비활성화됩니다.
# 키 생성: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 케어 리마인더 크론 보호용 시크릿 - 선택 (api/push/care-reminders 호출 인증)
CRON_SECRET=

# Google Gemini API 키 - 선택. 진료 영수증/세부내역서 사진 OCR 자동입력에 사용.
# https://aistudio.google.com/apikey 에서 무료 발급 (무료 등급 제공).
# 미설정 시 진료기록 스캔 버튼만 비활성화되고 직접 입력은 그대로 동작합니다.
GEMINI_API_KEY=
# 사용할 Gemini 모델 (선택, 기본: gemini-2.0-flash)
GEMINI_MODEL=
# 스캔 폴백: Gemini(LLM)가 실패/한도초과면 브라우저에서 무료 OCR(Tesseract.js)이
# 자동 실행돼 날짜·금액을 채우고 인식 원문을 보여줍니다. (별도 키/설정 불필요)

# 앱 URL (로컬 개발)
NEXT_PUBLIC_APP_URL=http://localhost:3000
